# ============================================
# Config — запрещаем прямой доступ
# ============================================

Options -Indexes

# Запрещаем доступ ко всем файлам
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Fallback для Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>