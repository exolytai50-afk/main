# ============================================
# Pages — запрещаем прямой доступ
# ============================================

Options -Indexes

# Запрещаем доступ ко всем файлам
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>