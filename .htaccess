# ============================================================
#  GigaChef — конфигурация Apache (mod_rewrite)
# ============================================================

# --- Базовые настройки ---
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Принудительный HTTPS (нужно для платежей/webhook) ---
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Не переписываем реально существующие файлы и папки ---
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- API запросы идут напрямую ---
    RewriteRule ^api/ - [L]

    # --- КРОНЫ идут напрямую ---
    RewriteRule ^cron/ - [L]

    # --- Бэкапы доступны через PHP-скрипт (скачивание) ---
    RewriteRule ^download_backup\.php$ download_backup.php [L,QSA]

    # ========================================================
    #  ВСЕ ОСТАЛЬНЫЕ ЗАПРОСЫ НАПРАВЛЯЕМ В index.php
    # ========================================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# ============================================================
#  MIME-типы и кэширование иконок
# ============================================================
AddType image/x-icon .ico
AddType image/png .png
AddType application/sql .sql
AddType application/zip .zip
AddType application/gzip .gz

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ============================================================
#  БЕЗОПАСНОСТЬ
# ============================================================

# --- Запрет доступа к служебным файлам и папкам ---
<FilesMatch "^\.(htaccess|env|git)">
    Require all denied
</FilesMatch>

# --- Запрет доступа к логам и конфигурационным файлам ---
# ❌ Убрана блокировка .sql файлов (нужны для скачивания бэкапов)
# ❌ Убрана блокировка .json файлов (нужен manifest.json)
<FilesMatch "\.(log|md|lock|ini)$">
    Require all denied
</FilesMatch>

# --- Закрываем конфиги и includes от прямого доступа ---
RedirectMatch 403 ^/config/.*$
RedirectMatch 403 ^/includes/.*$
RedirectMatch 403 ^/database/.*$
RedirectMatch 403 ^/logs/.*$

# --- Бэкапы: запрещаем прямой доступ к файлам, но разрешаем через PHP-скрипт ---
<IfModule mod_rewrite.c>
    # Запрещаем прямой доступ к .sql файлам в /backups/
    RewriteCond %{REQUEST_URI} ^/backups/.*\.sql$ [NC]
    RewriteCond %{HTTP_COOKIE} !gigachef_admin=1
    RewriteRule ^ - [F,L]
</IfModule>

# --- Защитные заголовки ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

# ============================================================
#  ПРОИЗВОДИТЕЛЬНОСТЬ
# ============================================================

# --- Сжатие ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Кэширование статики ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# --- Не кэшировать PDF-квитанции ---
<FilesMatch "receipt\.php$">
    <IfModule mod_headers.c>
        Header set Cache-Control "private, no-store, no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

# ============================================================
#  ЗАГРУЗКА ФАЙЛОВ (для vision-сканера)
# ============================================================
<IfModule mod_php.c>
    php_value max_file_uploads 100
    php_value upload_max_filesize 6M
    php_value post_max_size 8M
    php_value max_execution_time 120
    php_value memory_limit 256M
</IfModule>

# --- Кастомные страницы ошибок ---
ErrorDocument 403 /pages/403.php
ErrorDocument 404 /pages/404.php
ErrorDocument 429 /pages/429.php
ErrorDocument 500 /pages/500.php
ErrorDocument 503 /pages/503.php